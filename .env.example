# === Beauty Clinic Environment Variables ===
# Copy this file to .env and fill in your values.

# Database (SQLite local file)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# NextAuth — generate a long random secret (use: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

# NextAuth URL — your app's public URL (no trailing slash)
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"
